# Copy into the repository being documented, as .github/workflows/docs.yml.
# This file is an example and does not run against docs-skills itself.
name: docs

on:
  push:
    branches: [main]
  workflow_dispatch:
    inputs:
      bootstrap:
        description: First run. Queues every module
        type: boolean
        default: false

permissions:
  contents: write
  pull-requests: write

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          # git-context deepens a shallow checkout on its own, but starting
          # deep saves the fetch.
          fetch-depth: 0

      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Install Vale
        uses: errata-ai/vale-action@v2.1.1
        with:
          version: 3.21.0
          files: README.md
          fail_on_error: false

      - name: Install pi and docs-skills
        run: |
          npm install -g --ignore-scripts @earendil-works/pi-coding-agent
          pi install git:git@github.com:opendatahub-io/docs-skills@v0.4.0

      - name: Sync docs
        id: sync
        env:
          ANTHROPIC_API_KEY: ${{ secrets.DOCS_LLM_KEY }}
        run: |
          set +e
          # -p processes the command and exits. Every line the chain writes
          # goes to stdout as plain text, each prefixed with its step name.
          pi -p "/docs-sync --repo . ${{ inputs.bootstrap && '--bootstrap' || '' }}"
          code=$?
          echo "code=$code" >> "$GITHUB_OUTPUT"
          # 1 means nothing to do, which is the normal outcome on most pushes.
          [ "$code" -eq 1 ] && exit 0
          exit "$code"

      - name: Open PR
        if: steps.sync.outputs.code == '0'
        uses: peter-evans/create-pull-request@v6
        with:
          branch: docs/sync-${{ github.sha }}
          title: "docs: sync for ${{ github.sha }}"
          body-path: .docs-gen/pr-body.md
          labels: documentation, automated
          commit-message: "docs: sync for ${{ github.sha }}"
          # Match `bot_author` in .docs-gen.yaml, or the next push retriggers
          # this workflow against its own commit.
          author: docs-bot <docs-bot@example.com>
