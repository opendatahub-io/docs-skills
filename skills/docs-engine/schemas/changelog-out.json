{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Changelog summary output",
  "description": "Only used when conventional_ratio falls below the floor. A repository writing conventional commits never reaches this step.",
  "type": "object",
  "required": ["sections"],
  "properties": {
    "sections": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": ["heading", "entries"],
        "properties": {
          "heading": {"type": "string", "minLength": 3, "maxLength": 60},
          "entries": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 10}
          }
        }
      }
    }
  }
}
