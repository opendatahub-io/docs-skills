{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Module analysis output",
  "description": "What the analyze-module step must return for one module.",
  "type": "object",
  "required": ["purpose", "responsibilities", "public_api", "dependencies", "onboarding_priority"],
  "properties": {
    "module": {"type": "string"},
    "purpose": {"type": "string", "minLength": 20},
    "responsibilities": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {"type": "string", "minLength": 3}
    },
    "public_api": {
      "type": "array", "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["name", "summary"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "kind": {"type": "string"},
          "summary": {"type": "string", "minLength": 3}
        }
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "data_flow": {"type": "string"},
    "gotchas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary"],
        "properties": {
          "summary": {"type": "string", "minLength": 5},
          "evidence": {"type": "string", "pattern": "^.+:[0-9]+$"}
        }
      }
    },
    "onboarding_priority": {"type": "string", "enum": ["first", "early", "later", "reference"]},
    "evidence": {
      "type": "array",
      "description": "Repo-relative paths backing the module's claims, with a line number where one line settles it. A module-level claim is often true of a file rather than of a line, so the line is optional here; `gotchas[].evidence` still requires one, because a trap is somewhere in particular.",
      "items": {"type": "string", "pattern": "^\\S+(:[0-9]+)?$"}
    }
  }
}
